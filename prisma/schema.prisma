generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Мұғалім жасайтын тапсырмалар (Әдебиет немесе Тіл)
model TheoryTask {
  id          String   @id @default(cuid())
  title       String
  category    String   // "LITERATURE", "PHONETICS", "MORPHOLOGY", "SYNTAX", "LEXICOLOGY"
  content     Json     // Сұрақтар мен жауаптар
  createdAt   DateTime @default(now())

  results     Result[] // Бұл тапсырманы орындаған оқушылардың нәтижелері
}

// ТЕОРИЯ нәтижелерін сақтайтын кесте
model Result {
  id          String   @id @default(cuid())
  studentName String   // Оқушының аты-жөні
  score       String?  // Мысалы: "8/10" немесе ұпай
  details     String   // ИИ-дің берген толық талдауы (мәтін түрінде)
  createdAt   DateTime @default(now())

  taskId      String
  task        TheoryTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

// ЭССЕ нәтижелерін сақтайтын ЖАҢА кесте
model EssayResult {
  id          String   @id @default(cuid())
  studentName String   // Оқушының аты-жөні
  topic       String   // Эссе тақырыбы
  essayText   String   // Оқушының жазған эссесі
  score       String?  // ИИ берген ұпай
  details     String   // ИИ-дің эссеге жасаған толық талдауы
  createdAt   DateTime @default(now())
}