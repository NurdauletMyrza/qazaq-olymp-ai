generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Мұғалім жасайтын тапсырмалар (Әдебиет немесе Тіл)
model TheoryTask {
  id          String   @id @default(cuid())
  title       String
  category    String   // "LITERATURE", "PHONETICS", "MORPHOLOGY", "SYNTAX", "LEXICOLOGY"
  content     Json     // Сұрақтар мен жауаптар
  createdAt   DateTime @default(now())

  results     Result[] // Бұл тапсырманы орындаған оқушылардың нәтижелері
}

// 2. Оқушының нәтижесі (Енді TheoryTask-қа байланған)
model Result {
  id          String   @id @default(cuid())
  studentName String
  totalScore  Int
  details     Json     // ИИ-дің толық талдауы
  createdAt   DateTime @default(now())

  // Жаңа байланыс: Variant-тың орнына TheoryTask
  taskId      String
  task        TheoryTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
}